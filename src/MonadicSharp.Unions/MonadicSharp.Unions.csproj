<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <LangVersion>14</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MonadicSharp.Unions</RootNamespace>

    <PackageId>MonadicSharp.Unions</PackageId>
    <PackageVersion>1.0.0-preview.2</PackageVersion>
    <Authors>Danny4897</Authors>
    <Description>Tagged union types (Union2, Union3, Union4) with Map/Bind/Match monadic operators and bridge to MonadicSharp Result/Option. Prepares codebases for C# 15 native Discriminated Unions — when they GA, swap to native DUs and keep the MonadicSharp extensions.</Description>
    <PackageTags>monadic-sharp;discriminated-union;tagged-union;result;option;map;bind;match;functional</PackageTags>
    <PackageProjectUrl>https://github.com/Danny4897/MonadicSharp</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Danny4897/MonadicSharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <LangVersion>preview</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\MonadicSharp.csproj" />
  </ItemGroup>

</Project>
